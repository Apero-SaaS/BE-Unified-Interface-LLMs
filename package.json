{
  "name": "litellm",
  "version": "1.96.0",
  "description": "Root npm manifest for this repo — pins root-level JS tooling (Prisma CLI, docs deps) and known-vulnerable transitive packages. Not published to any registry.",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "prism-react-renderer": "2.4.1",
    "prisma": "5.17.0",
    "react-copy-to-clipboard": "5.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "14.3.1",
    "@types/react-copy-to-clipboard": "5.0.7",
    "jest": "29.7.0"
  },
  "overrides": {
    "glob": "13.0.0",
    "minimatch": "10.2.5",
    "picomatch": "2.3.2",
    "@isaacs/brace-expansion": "5.0.0",
    "@babel/traverse": "7.28.5",
    "braces": "3.0.3"
  }
}
